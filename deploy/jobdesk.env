# Read by systemd/jobdesk.service on the server. See config.py for what each one does.
# Nothing private belongs here: this file is committed. Private values go in /srv/jobdesk/private.env.
JOBDESK_CV_REPO=/srv/jobdesk/cv
JOBDESK_DATA=/srv/jobdesk/data
JOBDESK_HOST=127.0.0.1
JOBDESK_PORT=8765
JOBDESK_SECURE_COOKIE=1
JOBDESK_OWNER_DIR=/srv/jobdesk/owner
