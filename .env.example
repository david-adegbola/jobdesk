# JobDesk settings. Copy to .env (git-ignored) and fill in what you need.
# JobDesk reads environment variables only; it does not read .env by itself. Load it first:
#   set -a; . ./.env; set +a; python3 server.py
# On the server, put private values in /srv/jobdesk/private.env (never committed).

# Where things are (see config.py for defaults)
JOBDESK_CV_REPO=
JOBDESK_DATA=
JOBDESK_HOST=127.0.0.1
JOBDESK_PORT=8765
JOBDESK_SECURE_COOKIE=0

# Owner tools (prompt builder, Prep page): folder with profile.json and an optional prep/ folder
JOBDESK_OWNER_DIR=
JOBDESK_PREP_DIR=

# The name written in the shared LaTeX CV template's footer. Member CV PDFs replace it with the
# member's own name. Leave empty to switch member PDF building off.
JOBDESK_CV_TEMPLATE_OWNER=

# Job sources that are off in sources.json and that this copy may read anyway, only after the site's
# owner has given permission: comma-separated source ids (e.g. uef). Leave empty.
JOBDESK_ENABLE_SOURCES=

# Työmarkkinatori search API (core/importers.py). Leave empty until KEHA-keskus has approved the
# käyttöönottoilmoitus; use the test credentials first, and check the field mapping against their docs.
JOBDESK_TMT_API_URL=
JOBDESK_TMT_API_KEY=

# Public pages: 1 shows the reserved (empty) advert spaces. No ad code is loaded until a consent tool is chosen.
JOBDESK_AD_SLOTS=0

# Optional page where site owners can contact whoever runs this JobDesk; added to the User-Agent
JOBDESK_CONTACT_URL=

# LLM features. mock (default) needs no key and returns clearly labelled fake output.
# live sends job-ad text to Claude and costs money; it needs ONE of the two keys below.
JOBDESK_LLM_MODE=mock
# Anthropic's API directly (keys start with sk-ant-)
ANTHROPIC_API_KEY=
# ...or OpenRouter, which forwards requests to Claude (keys start with sk-or-)
OPENROUTER_API_KEY=
JOBDESK_LLM_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
JOBDESK_LLM_EFFORT=low
# 1 = let the API retry a safety refusal on a fallback model (supported models only)
JOBDESK_LLM_FALLBACKS=1

# Deployment only: the CV repository the server clones on first set-up (deploy.sh --setup)
JOBDESK_CV_GIT_URL=

# Sign-in by emailed link (no passwords)
# JOBDESK_OPEN_SIGNUP=1                 # 0 = only people with an invitation code can create an account
# JOBDESK_PUBLIC_URL=http://localhost:8765   # the address put in sign-in links
# JOBDESK_EMAIL_BACKEND=log             # log (development: link printed in the server log), smtp, or memory (tests)
# JOBDESK_SMTP_HOST=
# JOBDESK_SMTP_PORT=587
# JOBDESK_SMTP_USER=
# JOBDESK_SMTP_PASSWORD=
# JOBDESK_EMAIL_FROM=JobDesk <signin@your-domain.example>
